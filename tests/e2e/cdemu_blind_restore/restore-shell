#!/bin/sh
# restore-shell — facade over tmux for blind-restore agents.
#
# Why this exists: the original agent_prompt.txt asked the LLM to
# hand-roll tmux idioms (capture-pane retry loops, send-keys + C-m,
# `remain-on-exit on`, server-died detection).  That's incidental
# complexity unrelated to the recovery process under test.  The
# blind-restore is supposed to evaluate the recovery PATH, not the
# agent's tmux fluency.  This wrapper collapses every per-action
# concern into a single command.
#
# Usage:
#   restore-shell start CMD...
#       Start CMD inside a fresh tmux session named "r".  Kills any
#       prior "r" session.  Sets remain-on-exit so the pane survives
#       CMD's exit and the final output is still readable.  Returns
#       immediately; CMD runs in the background.
#
#   restore-shell expect REGEX [TIMEOUT_SECS]
#       Poll until REGEX (extended grep) matches NEW output: output
#       written after what the last successful expect returned.  A
#       prompt you already answered can't match again.
#       Prints the new output in every case (none if nothing new);
#       `screen` shows the whole pane.
#       On match:        exits 0.  The output it printed now counts
#                        as seen.
#       On timeout:      exits 1.  Nothing counts as seen, so a retry
#                        with another REGEX still finds it.
#       On CMD exit:     no new output matched and CMD has exited:
#                        exits 2.
#       On session-gone: exits 2.
#       Default timeout: 60 s.  Each poll is 1 s apart.
#
#   restore-shell send TEXT
#       Send TEXT followed by ENTER.  Backslash escapes (\n etc.)
#       are NOT interpreted — pass the literal string you want typed.
#
#   restore-shell send-raw TEXT
#       Send TEXT without trailing ENTER.  For composing multi-step
#       keystroke sequences.
#
#   restore-shell screen
#       Print the current pane content.
#
#   restore-shell quit
#       Kill the "r" session.  No-op if it doesn't exist.
#
# The session name is "r" by default; override with $RESTORE_SHELL_SESSION
# if needed (rare).

set -u
SESSION="${RESTORE_SHELL_SESSION:-r}"

case "${1:-}" in
    start)
        shift
        if [ $# -eq 0 ]; then
            echo "[restore-shell] start: missing command" >&2
            exit 2
        fi
        tmux kill-session -t "$SESSION" 2>/dev/null || true
        # remain-on-exit lets us read the final output after CMD exits.
        # It is set in the same tmux invocation as new-session: run on
        # its own before any server exists, set-option just fails ("no
        # server running"), so the first session of every run went
        # without it.  When restore.sh exited, the pane, the session and
        # the server went with it, taking "[lcsas-restore] restore
        # complete" along, and `expect` saw only "ended unexpectedly".
        # Let tmux's own stderr flow directly to ours.  An earlier
        # version wrote to a fixed /tmp file which collided between
        # users (blind-agent runs as `lcsas-blind`; a prior root run
        # created the file with root-only perms).
        # history-limit: expect finds new output by absolute row
        # (scrollback + screen), and a full scrollback drops its oldest
        # rows, shifting every row after them.  It applies to panes
        # created after it is set, so it goes before new-session.
        if ! tmux start-server \; set-option -g remain-on-exit on \; \
                set-option -g history-limit 50000 \; \
                new-session -d -s "$SESSION" -- "$@" >&2; then
            echo "[restore-shell] tmux new-session failed (see above)" >&2
            exit 1
        fi
        # Let the child print its first prompt before the agent races
        # to capture-pane.
        sleep 0.5
        echo "[restore-shell] session $SESSION started: $*"
        ;;
    expect)
        pattern="${2:-}"
        timeout="${3:-60}"
        if [ -z "$pattern" ]; then
            echo "[restore-shell] expect: missing REGEX" >&2
            exit 2
        fi
        # Only output written after the last match counts (#551).  The
        # whole pane used to: after a disc swap and `send ""`, the box
        # of the prompt just answered was still on screen, so
        # `expect 'Insert the right disc'` matched it at once, before
        # the binary had even re-scanned, and the agent swapped again
        # for a prompt that never came.
        #
        # A match stores the cursor's position in the session option
        # @restore_shell_mark as "ROW COL".  ROW counts from the top of
        # the scrollback (history_size + cursor_y), so it survives
        # scrolling.  COL drops the part of that row already returned:
        # the cursor usually sits after a prompt such as "Password: ",
        # which must not match a second time.
        #
        # send does NOT move the mark.  The disc-swap prompt finds a
        # disc that mounts by itself without ENTER, so the restore can
        # resume and print its next box, or "restore complete", before
        # the agent's `send ""` runs.  A mark taken at send would hide
        # that output.
        deadline=$(( $(date +%s) + timeout ))
        while :; do
            # One tmux call, so the state line and the capture describe
            # the same instant: the server runs a client's commands back
            # to back, reading no pane output in between.
            if ! snap=$(tmux display-message -p -t "$SESSION" \
                    '#{pane_dead} #{history_size} #{cursor_y} #{cursor_x} #{@restore_shell_mark}' \; \
                    capture-pane -p -t "$SESSION" -S - -E - 2>/dev/null); then
                echo "[restore-shell] session $SESSION ended unexpectedly" >&2
                exit 2
            fi
            # shellcheck disable=SC2046  # split the state line on purpose
            set -- $(printf '%s\n' "$snap" | sed -n 1p)
            dead=$1
            here="$(( $2 + $3 )) $4"
            mark_row=${5:-0}
            mark_col=${6:-0}
            new=$(printf '%s\n' "$snap" | awk -v r="$mark_row" -v c="$mark_col" '
                NR == 1 { next }
                NR - 2 == r { $0 = substr($0, c + 1); if ($0 == "") next }
                NR - 2 >= r')
            if printf '%s\n' "$new" | grep -qE -e "$pattern"; then
                tmux set-option -t "$SESSION" @restore_shell_mark "$here" \
                    2>/dev/null
                printf '%s\n' "$new"
                exit 0
            fi
            # A dead pane (remain-on-exit) never prints again, so stop
            # waiting.  Print the new output, not the pane: tmux scrolls
            # a line into the scrollback when it marks the pane dead.
            if [ "$dead" = 1 ]; then
                printf '%s\n' "$new"
                printf '[restore-shell] the command in session %s has exited (status %s); no new output matched: %s\n' \
                    "$SESSION" \
                    "$(tmux display-message -p -t "$SESSION" '#{pane_dead_status}' 2>/dev/null)" \
                    "$pattern" >&2
                exit 2
            fi
            [ "$(date +%s)" -lt "$deadline" ] || break
            sleep 1
        done
        printf '%s\n' "$new"
        printf '[restore-shell] timeout (%ss): no new output matched: %s\n' \
            "$timeout" "$pattern" >&2
        exit 1
        ;;
    send)
        shift
        tmux send-keys -t "$SESSION" -- "$@" C-m
        ;;
    send-raw)
        shift
        tmux send-keys -t "$SESSION" -l -- "$@"
        ;;
    screen)
        tmux capture-pane -t "$SESSION" -p 2>/dev/null \
            || { echo "[restore-shell] no session $SESSION" >&2; exit 1; }
        ;;
    quit)
        tmux kill-session -t "$SESSION" 2>/dev/null || true
        ;;
    *)
        cat >&2 <<EOF
usage: restore-shell start CMD...
       restore-shell expect REGEX [TIMEOUT_SECS]
       restore-shell send TEXT
       restore-shell send-raw TEXT
       restore-shell screen
       restore-shell quit
EOF
        exit 2
        ;;
esac
