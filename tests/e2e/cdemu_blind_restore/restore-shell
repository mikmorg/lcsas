#!/bin/sh
# restore-shell — facade over tmux for blind-restore agents.
#
# Why this exists: the original agent_prompt.txt asked the LLM to
# hand-roll tmux idioms (capture-pane retry loops, send-keys + C-m,
# `remain-on-exit on`, server-died detection).  That's incidental
# complexity unrelated to the recovery process under test.  The
# blind-restore is supposed to evaluate the recovery PATH, not the
# agent's tmux fluency.  This wrapper collapses every per-action
# concern into a single command.
#
# Usage:
#   restore-shell start CMD...
#       Start CMD inside a fresh tmux session named "r".  Kills any
#       prior "r" session.  Sets remain-on-exit so the pane survives
#       CMD's exit and the final output is still readable.  Returns
#       immediately; CMD runs in the background.
#
#   restore-shell expect REGEX [TIMEOUT_SECS]
#       Poll until REGEX (extended grep) matches NEW output: output
#       written after what the last successful expect returned.  A
#       prompt you already answered can't match again.
#       Prints the new output in every case (none if nothing new);
#       `screen` shows the whole pane.
#       On match:        exits 0.  The output it printed now counts
#                        as seen.
#       On timeout:      exits 1.  Nothing counts as seen, so a retry
#                        with another REGEX still finds it.
#       On CMD exit:     no new output matched and CMD has exited:
#                        exits 2.
#       On session-gone: exits 2.
#       Default timeout: 60 s.  Each poll is 1 s apart.
#
#   restore-shell send TEXT
#       Send TEXT followed by ENTER.  Backslash escapes (\n etc.)
#       are NOT interpreted — pass the literal string you want typed.
#
#   restore-shell send-raw TEXT
#       Send TEXT without trailing ENTER.  For composing multi-step
#       keystroke sequences.
#
#   restore-shell screen
#       Print the current pane content.
#
#   restore-shell quit
#       Kill the "r" session.  No-op if it doesn't exist.
#
#   restore-shell swap-loop [MOUNT_DIR]
#       The prompts' disc-swap loop, so the agent need not type it or
#       save it to a file (#827).  At most 40 times: expect
#       'Insert the right disc|[Rr]estore complete' (120 s); on a disc box,
#       `sudo umount MOUNT_DIR`, `disc-loader eject`, `disc-loader insert`
#       the disc the box names, `sudo mount /dev/sr0 MOUNT_DIR`, then
#       `send ""` (ENTER).  MOUNT_DIR defaults to /media.
#       Which disc (#917): the first disc of the box's "It is on any disc
#       labelled:" list (newest first) that is in ~/disc-labels.txt and
#       not yet tried for this box; the same box (same pack) back means
#       that disc did not have it, so the next named disc is tried.  A box
#       naming none, or none left: the next data disc of
#       ~/disc-labels.txt in label order (LCSAS_META skipped, starting
#       over after the last) not yet tried for it.  Each swap line says
#       which rule picked the disc.
#       A disc box already on the screen and waiting for its answer
#       (the agent looked at it before starting the loop) is the first
#       swap; the loop does not wait for it to be printed again (#917).
#       On "restore complete" (any tier: "Restore complete" too), it
#       answers "Restore another backup set?" with n and exits 0.
#       If expect times out (1) or the session ends (2), it stops and
#       exits with expect's code; after 40 swaps it exits 1.
#       Its last line on stdout is always one of these two, and nothing
#       else prints them (#942):
#         SWAP-LOOP END: RESTORE COMPLETE   the restore has finished
#         SWAP-LOOP END: STOPPED            anything else: a timeout (a
#                                           prompt it cannot answer), the
#                                           session ended, 40 swaps, no
#                                           data disc; the line before
#                                           (stderr) says which
#       Run in the background, wait for a line starting "SWAP-LOOP END:".
#       $RESTORE_SHELL_DISC_LABELS overrides ~/disc-labels.txt.
#
# The session name is "r" by default; override with $RESTORE_SHELL_SESSION
# if needed (rare).

set -u
SESSION="${RESTORE_SHELL_SESSION:-r}"

# swap-loop's last line (#942).  The agent's prompts name these two
# strings; tests/recovery_hardening/test_agent_prompt.py checks that
# they do, letter for letter.  Both start with the one prefix an agent
# waits for, so a wait never outlives the loop.
SWAP_LOOP_DONE='SWAP-LOOP END: RESTORE COMPLETE'
SWAP_LOOP_STOPPED='SWAP-LOOP END: STOPPED'

# take_waiting_box: succeed if a disc box is on the screen now, waiting
# for its answer, and mark it seen, as a matching `expect` would.
#
# swap-loop's `expect` waits for NEW output.  The agent nearly always
# looks at the box first (`expect` marks it seen; `screen` does not),
# and the restore, waiting at that box, prints nothing more, so the loop
# waited out its 120 s and stopped after 0 disc swaps: every swap-loop
# of the 2026-11-18/19 blind runs did (#917).  The agent then swapped
# by hand, and in three runs scripted the swaps.
#
# "Waiting" means the cursor sits on the box's own prompt line (">",
# nothing typed after it) and the lines above it, up to the one saying
# "Insert the right disc", are the box's frame.  Once ENTER is sent the
# terminal echoes it and the cursor leaves that line, so a box already
# answered is not taken again.
take_waiting_box() {
    snap=$(tmux display-message -p -t "$SESSION" \
            '#{pane_dead} #{history_size} #{cursor_y} #{cursor_x}' \; \
            capture-pane -p -t "$SESSION" 2>/dev/null) || return 1
    # shellcheck disable=SC2046  # split the state line on purpose
    set -- $(printf '%s\n' "$snap" | sed -n 1p)
    [ "${1:-1}" = 0 ] || return 1
    printf '%s\n' "$snap" | awk -v y="$3" -v x="$4" '
        NR > 1 { line[NR - 2] = $0 }
        END {
            if (x > 2 || line[y] !~ /^> ?$/) exit 1
            for (i = y - 1; i >= 0; i--) {
                if (line[i] ~ /Insert the right disc/) exit 0
                if (line[i] !~ /^[|+]/) exit 1
            }
            exit 1
        }' || return 1
    tmux set-option -t "$SESSION" @restore_shell_mark "$(( $2 + $3 )) $4" \
        2>/dev/null
}

# box_discs: read output on stdin; for the LAST disc box in it print the
# box's pack ("-" when it names none) on the first line, then each disc
# the box names, one per line, in its order.  The named discs are the
# frame lines under "It is on any disc labelled:", up to the next line
# that is not a label: never the "Currently searching:" paths, and never
# the disc of "It is on a disc newer than:" (tier 3), which is not the
# disc wanted.  Both readers print that heading byte for byte, newest
# disc first, at most 8 (#896).
box_discs() {
    awk '
        /is required for the next file/ {
            pack = $0
            sub(/.*Pack /, "", pack); sub(/\.\.\..*/, "", pack)
            n = 0; inlist = 0; next
        }
        /\| It is on any disc labelled:/ { inlist = 1; next }
        inlist && /^\|   [^ |]+ +\|$/ {
            label = $0
            sub(/^\|   /, "", label); sub(/ +\|$/, "", label)
            if (label != "LCSAS_META") got[++n] = label
            next
        }
        { inlist = 0 }
        /Insert the right disc/ {
            last_pack = (pack == "" ? "-" : pack); last_n = n
            for (i = 1; i <= n; i++) last[i] = got[i]
            pack = ""; n = 0
        }
        END {
            if (last_pack == "") exit
            print last_pack
            for (i = 1; i <= last_n; i++) print last[i]
        }'
}

case "${1:-}" in
    start)
        shift
        if [ $# -eq 0 ]; then
            echo "[restore-shell] start: missing command" >&2
            exit 2
        fi
        tmux kill-session -t "$SESSION" 2>/dev/null || true
        # remain-on-exit lets us read the final output after CMD exits.
        # It is set in the same tmux invocation as new-session: run on
        # its own before any server exists, set-option just fails ("no
        # server running"), so the first session of every run went
        # without it.  When restore.sh exited, the pane, the session and
        # the server went with it, taking "[lcsas-restore] restore
        # complete" along, and `expect` saw only "ended unexpectedly".
        # Let tmux's own stderr flow directly to ours.  An earlier
        # version wrote to a fixed /tmp file which collided between
        # users (blind-agent runs as `lcsas-blind`; a prior root run
        # created the file with root-only perms).
        # history-limit: expect finds new output by absolute row
        # (scrollback + screen), and a full scrollback drops its oldest
        # rows, shifting every row after them.  It applies to panes
        # created after it is set, so it goes before new-session.
        if ! tmux start-server \; set-option -g remain-on-exit on \; \
                set-option -g history-limit 50000 \; \
                new-session -d -s "$SESSION" -- "$@" >&2; then
            echo "[restore-shell] tmux new-session failed (see above)" >&2
            exit 1
        fi
        # Let the child print its first prompt before the agent races
        # to capture-pane.
        sleep 0.5
        echo "[restore-shell] session $SESSION started: $*"
        ;;
    expect)
        pattern="${2:-}"
        timeout="${3:-60}"
        if [ -z "$pattern" ]; then
            echo "[restore-shell] expect: missing REGEX" >&2
            exit 2
        fi
        # Only output written after the last match counts (#551).  The
        # whole pane used to: after a disc swap and `send ""`, the box
        # of the prompt just answered was still on screen, so
        # `expect 'Insert the right disc'` matched it at once, before
        # the binary had even re-scanned, and the agent swapped again
        # for a prompt that never came.
        #
        # A match stores the cursor's position in the session option
        # @restore_shell_mark as "ROW COL".  ROW counts from the top of
        # the scrollback (history_size + cursor_y), so it survives
        # scrolling.  COL drops the part of that row already returned:
        # the cursor usually sits after a prompt such as "Password: ",
        # which must not match a second time.
        #
        # send does NOT move the mark.  The disc-swap prompt finds a
        # disc that mounts by itself without ENTER, so the restore can
        # resume and print its next box, or "restore complete", before
        # the agent's `send ""` runs.  A mark taken at send would hide
        # that output.
        deadline=$(( $(date +%s) + timeout ))
        while :; do
            # One tmux call, so the state line and the capture describe
            # the same instant: the server runs a client's commands back
            # to back, reading no pane output in between.
            if ! snap=$(tmux display-message -p -t "$SESSION" \
                    '#{pane_dead} #{history_size} #{cursor_y} #{cursor_x} #{@restore_shell_mark}' \; \
                    capture-pane -p -t "$SESSION" -S - -E - 2>/dev/null); then
                echo "[restore-shell] session $SESSION ended unexpectedly" >&2
                exit 2
            fi
            # shellcheck disable=SC2046  # split the state line on purpose
            set -- $(printf '%s\n' "$snap" | sed -n 1p)
            dead=$1
            here="$(( $2 + $3 )) $4"
            mark_row=${5:-0}
            mark_col=${6:-0}
            new=$(printf '%s\n' "$snap" | awk -v r="$mark_row" -v c="$mark_col" '
                NR == 1 { next }
                NR - 2 == r { $0 = substr($0, c + 1); if ($0 == "") next }
                NR - 2 >= r')
            if printf '%s\n' "$new" | grep -qE -e "$pattern"; then
                tmux set-option -t "$SESSION" @restore_shell_mark "$here" \
                    2>/dev/null
                printf '%s\n' "$new"
                exit 0
            fi
            # A dead pane (remain-on-exit) never prints again, so stop
            # waiting.  Print the new output, not the pane: tmux scrolls
            # a line into the scrollback when it marks the pane dead.
            if [ "$dead" = 1 ]; then
                printf '%s\n' "$new"
                printf '[restore-shell] the command in session %s has exited (status %s); no new output matched: %s\n' \
                    "$SESSION" \
                    "$(tmux display-message -p -t "$SESSION" '#{pane_dead_status}' 2>/dev/null)" \
                    "$pattern" >&2
                exit 2
            fi
            [ "$(date +%s)" -lt "$deadline" ] || break
            sleep 1
        done
        printf '%s\n' "$new"
        printf '[restore-shell] timeout (%ss): no new output matched: %s\n' \
            "$timeout" "$pattern" >&2
        exit 1
        ;;
    send)
        shift
        tmux send-keys -t "$SESSION" -- "$@" C-m
        ;;
    send-raw)
        shift
        tmux send-keys -t "$SESSION" -l -- "$@"
        ;;
    screen)
        tmux capture-pane -t "$SESSION" -p 2>/dev/null \
            || { echo "[restore-shell] no session $SESSION" >&2; exit 1; }
        ;;
    quit)
        tmux kill-session -t "$SESSION" 2>/dev/null || true
        ;;
    swap-loop)
        mnt="${2:-/media}"
        labels="${RESTORE_SHELL_DISC_LABELS:-$HOME/disc-labels.txt}"
        discs=$(grep -v '^LCSAS_META$' "$labels" 2>/dev/null | grep -v '^[[:space:]]*$')
        if [ -z "$discs" ]; then
            echo "[restore-shell] swap-loop: no data disc listed in $labels" >&2
            echo "$SWAP_LOOP_STOPPED"
            exit 2
        fi
        count=$(printf '%s\n' "$discs" | wc -l)
        swaps=0
        idx=0          # next disc in label order, for boxes naming none
        cur_pack=      # the pack of the box being answered
        tried=         # discs inserted for that box
        # A box already on the screen is the first swap (#917).
        waiting=0
        take_waiting_box && waiting=1
        while [ "$swaps" -lt 40 ]; do
            if [ "$waiting" = 1 ]; then
                waiting=0
                out="[restore-shell] swap-loop: a disc box is waiting on the screen"
                # The box itself, with some scrollback: a box with many
                # named discs and search paths can be taller than the
                # pane.  Only read for its discs: an older "restore
                # complete" in the scrollback must not end the loop.
                boxtext=$(tmux capture-pane -p -t "$SESSION" -S -80 2>/dev/null)
                rc=0
            else
                # Tier 1 says "restore complete"; tier 3 and restore.sh's
                # closing frame say "Restore complete." (#942).
                out=$(sh "$0" expect 'Insert the right disc|[Rr]estore complete' 120)
                rc=$?
                boxtext=$out
            fi
            printf '%s\n' "$out"
            if [ "$rc" -ne 0 ]; then
                if [ "$rc" = 1 ]; then
                    why="nothing new for 120 s: the restore may be waiting at a prompt swap-loop does not answer; look with restore-shell screen"
                else
                    why="the restore's session ended; look with restore-shell screen"
                fi
                echo "[restore-shell] swap-loop: stopped after $swaps disc swaps (expect exit $rc): $why" >&2
                echo "$SWAP_LOOP_STOPPED"
                exit "$rc"
            fi
            case "$out" in
                *"restore complete"*|*"Restore complete"*)
                    # Answer "Restore another backup set?" with no.
                    sh "$0" send n
                    echo "[restore-shell] swap-loop: done after $swaps disc swaps"
                    echo "$SWAP_LOOP_DONE"
                    exit 0
                    ;;
            esac
            # Which disc: the first disc the box names that has not been
            # tried for it (the same box back means that disc did not
            # have the pack); only when it names none, or none left, the
            # next disc in label order not yet tried for it (#917).
            info=$(printf '%s\n' "$boxtext" | box_discs)
            pack=$(printf '%s\n' "$info" | sed -n 1p)
            if [ "$pack" = "-" ] || [ "$pack" != "$cur_pack" ]; then
                tried=
            fi
            cur_pack=$pack
            label=
            for d in $(printf '%s\n' "$info" | sed -n '2,$p'); do
                case " $tried " in *" $d "*) continue ;; esac
                if printf '%s\n' "$discs" | grep -qxF -- "$d"; then
                    label=$d
                    rule="the disc the box names"
                    break
                fi
            done
            if [ -z "$label" ]; then
                n=0
                while [ "$n" -lt "$count" ]; do
                    d=$(printf '%s\n' "$discs" | sed -n "$((idx % count + 1))p")
                    idx=$((idx + 1))
                    n=$((n + 1))
                    case " $tried " in *" $d "*) continue ;; esac
                    label=$d
                    break
                done
                rule="label order: the box names no disc left to try"
                if [ -z "$label" ]; then
                    # Every disc tried for this box: start the round again.
                    tried=
                    label=$(printf '%s\n' "$discs" | sed -n "$((idx % count + 1))p")
                    idx=$((idx + 1))
                    rule="label order: every disc tried for this box"
                fi
            fi
            tried="$tried $label"
            swaps=$((swaps + 1))
            echo "[restore-shell] swap-loop: disc swap $swaps: $label at $mnt ($rule)"
            sudo umount "$mnt" 2>/dev/null
            # The disc in the drive may be mounted somewhere else: the
            # agent often mounts data discs at /mnt by hand and then runs
            # a bare swap-loop.  `disc-loader eject` unmounts /dev/sr0
            # wherever it is, as the agents' own working swaps did, so the
            # next disc is not mounted beside a stale mount of the last
            # one (#917).
            disc-loader eject >/dev/null
            disc-loader insert "$label"
            sudo mount /dev/sr0 "$mnt"
            sh "$0" send ""
        done
        echo "[restore-shell] swap-loop: stopped after 40 disc swaps" >&2
        echo "$SWAP_LOOP_STOPPED"
        exit 1
        ;;
    *)
        cat >&2 <<EOF
usage: restore-shell start CMD...
       restore-shell expect REGEX [TIMEOUT_SECS]
       restore-shell send TEXT
       restore-shell send-raw TEXT
       restore-shell screen
       restore-shell quit
       restore-shell swap-loop [MOUNT_DIR]
swap-loop's last line is "$SWAP_LOOP_DONE" or "$SWAP_LOOP_STOPPED".
EOF
        exit 2
        ;;
esac
